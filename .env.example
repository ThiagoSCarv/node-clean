# Conexão com o PostgreSQL (credenciais definidas em docker-compose.yml)
DATABASE_URL="postgresql://postgres:docker@localhost:5432/nest-clean?schema=public"

# Porta HTTP da aplicação
PORT=3333

# Chaves RSA (base64) para assinar/verificar JWT com RS256.
# Gere um par com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# e converta cada arquivo para base64 (ex.: `base64 -w0 private.pem`).
JWT_PRIVATE_KEY="<chave-privada-rsa-em-base64>"
JWT_PUBLIC_KEY="<chave-publica-rsa-em-base64>"
